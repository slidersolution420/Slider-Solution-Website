# App
NEXT_PUBLIC_APP_URL=https://slidersolution.com

# Supabase (project: ecuhecmfxfavjdxuctkg)
NEXT_PUBLIC_SUPABASE_URL=https://ecuhecmfxfavjdxuctkg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Hype Payment Gateway
HYPE_API_KEY=
HYPE_REFERER=https://slidersolution.com
HYPE_WEBHOOK_SECRET=

# Resend Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@slidersolution.com
OWNER_ALERT_EMAIL=ceo@slidersolution.com

# Admin dashboard password (what you type to log in — keep separate from CRON_SECRET)
ADMIN_PASSWORD=

# Cron job auth token — used only by automated jobs (generate: openssl rand -hex 32)
CRON_SECRET=

# Keystatic CMS - GitHub mode (for in-browser editing at /keystatic on production)
# Leave blank for local dev (uses local storage mode)
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# PostHog Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
