# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # NEVER expose to browser

# ─── App URL ─────────────────────────────────────────────────────────────────
# Development: http://localhost:3000
# Production:  https://slidersolution.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Hype Payment Gateway ────────────────────────────────────────────────────
# Get from Hype dashboard
HYPE_API_KEY=          # From Hype dashboard
HYPE_REFERER=          # Referer ID from Hype account
HYPE_WEBHOOK_SECRET=   # From Hype dashboard after registering webhook URL
# Webhook URL to register: https://slidersolution.com/api/checkout/webhook

# ─── Tapuz Shipping ──────────────────────────────────────────────────────────
# Customer code from Tapuz Express account (test value '4041' triggers mock mode)
TAPUZ_CUSTOMER_CODE=4041
# Sender/pickup code (defaults to TAPUZ_CUSTOMER_CODE if not set)
TAPUZ_SENDER_CODE=

# ─── Resend Email ────────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=support@slidersolution.com
OWNER_ALERT_EMAIL=your@email.com  # Receives B2B signup alerts

# ─── Cron / Automation ────────────────────────────────────────────────────────
# Secret token for protecting cron-triggered API routes
# Set same value in Supabase Edge Function env vars
CRON_SECRET=your-cron-secret-here

# ─── PostHog Analytics ───────────────────────────────────────────────────────
# Get from: https://app.posthog.com → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Sentry Error Monitoring ─────────────────────────────────────────────────
# Get from: https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://your@sentry.io/project

# ─── Cloudinary Media ────────────────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ─── Feature Flags ───────────────────────────────────────────────────────────
# SHOW_GUARANTEE: Show money-back guarantee badge in trust bar (false at launch)
SHOW_GUARANTEE=false

# ENABLE_EXIT_POPUP: Show exit intent popup
ENABLE_EXIT_POPUP=true

# ENABLE_REORDER_EMAIL: Send Day+30 wholesale reorder email
ENABLE_REORDER_EMAIL=false

# SHIPPING_CUTOFF_HOUR: Hour in Israel time (24h) for 'Shipping today' urgency
# Orders placed before this hour show 'Shipping today'; after → 'Ships tomorrow'
SHIPPING_CUTOFF_HOUR=16
