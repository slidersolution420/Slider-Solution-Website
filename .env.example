# ─── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # NEVER expose to browser

# ─── Hype Payment Gateway ────────────────────────────────────────────────────
# Get from Hype dashboard (provided after Wave 1)
HYPE_API_KEY=
HYPE_WEBHOOK_SECRET=

# ─── Tapuz Shipping ──────────────────────────────────────────────────────────
# Get from Tapuz dashboard (provided after Wave 2)
TAPUZ_API_KEY=

# ─── Resend Email ────────────────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=support@slidersolution.com
OWNER_ALERT_EMAIL=your@email.com  # Receives B2B signup alerts

# ─── PostHog Analytics ───────────────────────────────────────────────────────
# Get from: https://app.posthog.com → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Sentry Error Monitoring ─────────────────────────────────────────────────
# Get from: https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=https://your@sentry.io/project

# ─── Cloudinary Media ────────────────────────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# ─── Feature Flags ───────────────────────────────────────────────────────────
# SHOW_GUARANTEE: Show money-back guarantee badge in trust bar (false at launch)
SHOW_GUARANTEE=false

# ENABLE_EXIT_POPUP: Show exit intent popup
ENABLE_EXIT_POPUP=true

# ENABLE_REORDER_EMAIL: Send Day+30 wholesale reorder email
ENABLE_REORDER_EMAIL=false

# SHIPPING_CUTOFF_HOUR: Hour in Israel time (24h) for 'Shipping today' urgency
# Orders placed before this hour show 'Shipping today'; after → 'Ships tomorrow'
SHIPPING_CUTOFF_HOUR=16
